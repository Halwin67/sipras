# Salin file ini menjadi .env.local lalu isi dari Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Opsional untuk pengembangan lokal saja. Jangan gunakan service_role key di browser.
# SUPABASE_SERVICE_ROLE_KEY=DO_NOT_EXPOSE_THIS_KEY
